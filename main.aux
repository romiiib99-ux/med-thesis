\@writefile{lof}{\contentsline {figure}{\numberline {4-1}{\ignorespaces درصد عدم مصرف سیگار به تفکیک جنسیت، وضعیت اشتغال و سطح سواد سلامت. مقادیر روی ستون‌ها درصد را نشان می‌دهند و مقدارهای \lr {p} زیر هر گروه گزارش شده‌اند.\relax }}{36}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:no-smoking-grouped-bar}{{4-1}{36}{درصد عدم مصرف سیگار به تفکیک جنسیت، وضعیت اشتغال و سطح سواد سلامت. مقادیر روی ستون‌ها درصد را نشان می‌دهند و مقدارهای \lr {p} زیر هر گروه گزارش شده‌اند.\relax }{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4-2}{\ignorespaces  درصد برخورداری از فعالیت بدنی کافی در ۱۰۴ شرکت‌کننده، به تفکیک متغیرهای جمعیت‌شناختی و بالینی. مقدار دقیق درصد بالای هر ستون و مقدار \lr {p} مربوط به مقایسه آماری زیر نام هر متغیر ارائه شده است. \relax }}{37}{figure.caption.5}\protected@file@percent }
\newlabel{fig:sufficient-physical-activity}{{4-2}{37}{درصد برخورداری از فعالیت بدنی کافی در ۱۰۴ شرکت‌کننده، به تفکیک متغیرهای جمعیت‌شناختی و بالینی. مقدار دقیق درصد بالای هر ستون و مقدار \lr {p} مربوط به مقایسه آماری زیر نام هر متغیر ارائه شده است. \relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4-3}{\ignorespaces  مقایسه درصد پایبندی به رژیم غذایی بر حسب تحصیلات، محل سکونت، وضعیت اقتصادی، سواد سلامت و پایبندی دارویی در ۹۰ شرکت‌کننده. مقدار دقیق درصد در بالای هر ستون و مقدار \lr {p} زیر نام هر متغیر مستقل نشان داده شده است. ستون بنفش رده نخست و ستون فیروزه‌ای رده دوم هر مقایسه را نشان می‌دهد. \relax }}{38}{figure.caption.6}\protected@file@percent }
\newlabel{fig:diet-adherence-grouped-bar}{{4-3}{38}{مقایسه درصد پایبندی به رژیم غذایی بر حسب تحصیلات، محل سکونت، وضعیت اقتصادی، سواد سلامت و پایبندی دارویی در ۹۰ شرکت‌کننده. مقدار دقیق درصد در بالای هر ستون و مقدار \lr {p} زیر نام هر متغیر مستقل نشان داده شده است. ستون بنفش رده نخست و ستون فیروزه‌ای رده دوم هر مقایسه را نشان می‌دهد. \relax }{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4-4}{\ignorespaces  مقایسهٔ درصد سلامت روانشناختی بر حسب جنسیت، تاهل، اشتغال، تحصیلات و سواد سلامت در ۶۹ شرکت‌کننده. درصد دقیق روی هر ستون و مقدار \lr {p} زیر هر گروه مستقل نمایش داده شده است. ستون بنفش ردهٔ نخست و ستون فیروزه‌ای ردهٔ دوم هر گروه را نشان می‌دهد. \relax }}{39}{figure.caption.7}\protected@file@percent }
\newlabel{fig:psychological-health-grouped-bar-chart}{{4-4}{39}{مقایسهٔ درصد سلامت روانشناختی بر حسب جنسیت، تاهل، اشتغال، تحصیلات و سواد سلامت در ۶۹ شرکت‌کننده. درصد دقیق روی هر ستون و مقدار \lr {p} زیر هر گروه مستقل نمایش داده شده است. ستون بنفش ردهٔ نخست و ستون فیروزه‌ای ردهٔ دوم هر گروه را نشان می‌دهد. \relax }{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4-5}{\ignorespaces مقایسه درصد پایبندی کلی برحسب جنسیت، وضعیت تاهل، سطح تحصیلات، سواد سلامت و پایبندی دارویی در ۲۶ شرکت‌کننده. مقدار دقیق درصد بالای هر میله و مقدار \lr {\textit  {p}} زیر نام هر متغیر گزارش شده است.\relax }}{40}{figure.caption.8}\protected@file@percent }
\newlabel{fig:overall-adherence-grouped-bar}{{4-5}{40}{مقایسه درصد پایبندی کلی برحسب جنسیت، وضعیت تاهل، سطح تحصیلات، سواد سلامت و پایبندی دارویی در ۲۶ شرکت‌کننده. مقدار دقیق درصد بالای هر میله و مقدار \lr {\textit {p}} زیر نام هر متغیر گزارش شده است.\relax }{figure.caption.8}{}}
